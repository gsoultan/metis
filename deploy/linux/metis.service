# Metis as a systemd service, as the deb, rpm and Arch packages install it.
#
# It does not start on install. Metis refuses to come up without DATABASE_URL,
# ENCRYPTION_KEY and JWT_SECRET, so a unit enabled before /etc/metis/metis.env
# is filled in would only restart into the same refusal. Fill that in, then:
#
#   systemctl enable --now metis
#
# Overrides belong in `systemctl edit metis`, not in this file: the package
# owns it and an upgrade replaces it.

[Unit]
Description=Metis BPMN and DMN engine
Documentation=https://github.com/gsoultan/metis
# The database is usually on another host. Where it is on this one, add
# `After=postgresql.service` in an override.
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=metis
Group=metis
EnvironmentFile=/etc/metis/metis.env
ExecStart=/usr/bin/metis

# config.yaml is read from, and the setup wizard writes it to, the working
# directory. StateDirectory creates /var/lib/metis owned by the service user,
# and it is the only place the service can write.
StateDirectory=metis
StateDirectoryMode=0750
WorkingDirectory=/var/lib/metis
UMask=0027

# On SIGTERM a replica waits METIS_SHUTDOWN_DRAIN (20s by default) for the jobs
# it is running. Leave room for that, so systemd does not kill a job mid-step.
# Raise this with the drain if you raise the drain.
TimeoutStopSec=60
KillMode=mixed
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# Hardening. Metis writes nothing outside its state directory, listens on an
# unprivileged port by default, and starts no child processes in a server
# deployment, so it needs none of what this takes away.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
