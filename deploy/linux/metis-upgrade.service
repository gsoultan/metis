# Runs `metis upgrade` for a request the Upgrades page left; started by
# metis-upgrade.path, never enabled on its own. Root, because it installs a
# package and restarts metis.service: the steps it takes, and what it
# refuses, are in docs/upgrading.md. Progress goes to
# /var/lib/metis/upgrade/status.json and to this unit's journal.
[Unit]
Description=Upgrade Metis to the release asked for on the Upgrades page
Documentation=https://github.com/gsoultan/metis/blob/main/docs/upgrading.md
ConditionPathExists=/var/lib/metis/upgrade-request.json
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/metis upgrade --from-request /var/lib/metis/upgrade-request.json
# Download, backup, install and the new release's start, with room for a
# large database's pg_dump.
TimeoutStartSec=2h
PrivateTmp=true
