# Environment for the Metis service. Read by systemd (EnvironmentFile=) and by
# the OpenRC script on Alpine, so keep to plain KEY=value lines: no `export`,
# and double quotes around a value with spaces.
#
# This file holds secrets. It is root:metis 0640, and the package will not
# overwrite your edits on upgrade. Every setting is listed in the README.

# PostgreSQL. Required: Metis refuses to start without a database.
DATABASE_URL=

# Both at least 32 characters and generated, never typed. The server refuses a
# weak or published value.
#   openssl rand -hex 24      # ENCRYPTION_KEY
#   openssl rand -base64 48   # JWT_SECRET
# Lose ENCRYPTION_KEY and the encrypted data is gone with it: keep a copy
# somewhere other than this host.
ENCRYPTION_KEY=
JWT_SECRET=

# HTTP API and the embedded UI.
METIS_HTTP_ADDRESS=:8080

# The address people reach Metis on, for links in mail and task links.
#METIS_PUBLIC_URL=https://metis.example.com

# Set when a reverse proxy sits in front, so client addresses are taken from it.
#METIS_TRUSTED_PROXIES=127.0.0.1/32

# Metrics stay on loopback unless you publish them.
#METIS_METRICS_ADDRESS=127.0.0.1:9464

# Opens the first-run wizard. Unset, a one-time token is printed in the log:
#   journalctl -u metis | grep -i setup
#METIS_SETUP_TOKEN=
