# Environment for the metis systemd service, read by /usr/lib/systemd/system/metis.service.
#
# The package manager keeps your edits to this file across upgrades. It is
# readable by root and the metis group only, because it holds secrets.
#
# Every METIS_* setting is listed in the README; only the ones a first start
# needs are here.

# REQUIRED. The PostgreSQL the engine keeps its state in; the server refuses
# to start without it. On a new database it then serves the setup wizard,
# which writes config.yaml to /var/lib/metis.
#DATABASE_URL=postgres://metis:CHANGE_ME@localhost:5432/metis?sslmode=disable

# Secrets, at least 32 characters each; the server refuses weak ones. When the
# setup wizard writes config.yaml (in /var/lib/metis), the values there win.
# Generate with: openssl rand -base64 48
#JWT_SECRET=
# Generate with: openssl rand -hex 24
#ENCRYPTION_KEY=

# Where the HTTP API and the embedded UI listen.
#METIS_HTTP_ADDRESS=:8080

# The address people reach this server at, for links in e-mails and redirects.
#METIS_PUBLIC_URL=https://metis.example.com

# Prometheus metrics. Loopback by default; widen it only if a scraper on
# another host needs it.
#METIS_METRICS_ADDRESS=127.0.0.1:9464

# Large variable payloads and the finished-instance archive, if you use the
# directory stores. Keep them under /var/lib/metis: the unit makes the rest of
# the filesystem read-only.
#METIS_PAYLOAD_DIR=/var/lib/metis/payloads
#METIS_ARCHIVE_DIR=/var/lib/metis/archive
